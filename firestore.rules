rules_version = '2';

// ===================================================================
// MODO BETA — regras abertas de propósito.
// Sem Firebase Auth (login é só PIN conferido no próprio app), então
// não tem como restringir leitura/escrita por usuário/papel ainda.
// Qualquer pessoa com o link do site lê e grava os dados.
// REVISAR ANTES DE USAR COM CLIENTES DE VERDADE (voltar ao modelo com
// Firebase Auth + Cloud Functions, que já está pronto e só precisa
// terminar o deploy).
// ===================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
